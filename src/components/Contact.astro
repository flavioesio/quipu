---
import { U, S, contact, type Lang } from '../lib/site';
const { lang } = Astro.props as { lang: Lang };
const x = U[lang];
const mail = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/></svg>';
const chat = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4z"/></svg>';
const channels = [
  [mail, 'E-mail', contact.email, `mailto:${contact.email}`],
  ...contact.whatsapp.map((w) => [chat, `WhatsApp · ${w.label}`, w.display, `https://wa.me/${w.number}`]),
];
---
<section id="contato">
  <div class="w"><div class="ct2">
    <div>
      <div class="k">{x.ck}</div><h2>{x.ch}</h2><p class="lead">{x.cl}</p>
      <ul class="cl2">
        {channels.map(([icon, label, value, href]) => <li><i set:html={icon} /><span><b>{label}</b><a href={href}>{value}</a></span></li>)}
      </ul>
    </div>
    <!-- Envio: defina PUBLIC_FORM_ENDPOINT no arquivo .env (veja INSTALACAO.md). Sem isso, o formulário só simula o envio. -->
    <form id="f" class="fm">
      <div class="fr">
        <label><span>{x.ph[0]}</span><input required name="nome" autocomplete="name" /></label>
        <label><span>{x.ph[1]}</span><input required type="email" name="email" autocomplete="email" /></label>
      </div>
      <label><span>{x.sk}</span><select id="sel" name="servico">{S.map((s, i) => <option value={i}>{s.L[lang][0]}</option>)}</select></label>
      <label><span>{x.ph[2]}</span><textarea rows="4" name="mensagem"></textarea></label>
      <button class="btn t" type="submit">{x.send} →</button>
      <p class="ok" id="ok">{x.ok}</p>
      <p class="ok err" id="err">{x.err}</p>
    </form>
  </div></div>
</section>
