---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import { langs, S, G, U, IC, T, seo, sections, slugs, servicePath, orgId, htmlLang, brand, url, num, type Lang } from '../../lib/site';

export function getStaticPaths() {
  return langs.flatMap((lang) => S.map((s) => ({ params: { lang, slug: `${sections[lang]}/${slugs[s.s][lang]}` }, props: { id: s.s } })));
}
const lang = Astro.params.lang as Lang;
const { id } = Astro.props as { id: string };
const x = U[lang];
const i = S.findIndex((s) => s.s === id);
const s = S[i];
const d = s.L[lang];
const ph: string[] = d[3];
const [h1, title, description] = seo[id][lang];
const paths = Object.fromEntries(langs.map((l) => [l, servicePath(l, id)])) as Record<Lang, string>;
const site = Astro.site ?? new URL('https://quipuglobal.netlify.app');
const pageUrl = new URL(url(lang, paths[lang]), site).href;
const homeUrl = new URL(url(lang), site).href;
const fill = (t: string) => t.replace('{t}', d[0]).replace('{who}', d[2]).replace('{p1}', ph[0]).replace('{p2}', ph[2]).replace('{p3}', ph[4]);
const faq = x.sf.map(([q, a]: string[]) => [fill(q), fill(a)] as [string, string]);
const jsonld = [
  { '@type': 'Service', '@id': `${pageUrl}#service`, name: h1, serviceType: d[0], description, url: pageUrl, inLanguage: htmlLang[lang], provider: { '@id': orgId(site) }, areaServed: brand.areaServed, category: G[lang][s.g] },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: x.nav[0], item: homeUrl },
    { '@type': 'ListItem', position: 2, name: x.sk, item: `${homeUrl}#servicos` },
    { '@type': 'ListItem', position: 3, name: d[0], item: pageUrl },
  ] },
];
---
<Base lang={lang} title={title} description={description} paths={paths} jsonld={jsonld}>
  <div class="w" style={`--c:${s.c}`}>
    <Breadcrumb items={[{ name: x.nav[0], href: url(lang) }, { name: x.sk, href: url(lang, '#servicos') }, { name: d[0] }]} />
    <div class="sh">
      <div>
        <div class="big">{num(i)}</div>
        <span class="pill">{x.plan} · {G[lang][s.g]}</span>
        <h1>{h1}</h1><p class="lead">{d[1]}</p>
        <div class="row"><a class="btn t" href="#contato" data-s={i}>{x.want}</a></div>
      </div>
      <div class="art">
        <svg class="rg" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round" />
          <circle cx="100" cy="100" r="68" fill="currentColor" opacity=".12" />
          <circle cx="172" cy="60" r="8" fill="currentColor" /><circle cx="28" cy="142" r="5" fill="#ffc53d" /><circle cx="150" cy="172" r="6" fill="#ff5a36" />
        </svg>
        <div class="mi" set:html={IC[s.s]} />
      </div>
    </div>

    <section class="sv-about">
      <div class="k">{x.abk}</div>
      <h2 class="vh-h">{d[0]}</h2>
      <p class="lead2">{d[5][0]}</p>
      <p>{d[5][1]}</p>
    </section>

    <div class="plan">
      <div class="pl-steps">
        <div class="k">{x.stk}</div><h2>{x.sth}</h2>
        <ol class="pr">
          {[0, 2, 4].map((k, j) => (
            <li><i class="pn2">0{j + 1}</i><div><small>{x.wk} {T[j]}</small><h3>{ph[k]}</h3><p>{ph[k + 1]}</p></div></li>
          ))}
        </ol>
      </div>
      <aside class="pl-res">
        <div class="k">{x.gk}</div><h2>{x.gh}</h2>
        <ul class="pm">{s.kv.map((v, k) => <li><b>{v}</b><span>{d[4][k]}</span></li>)}</ul>
        <p class="pnote">{x.note}</p>
      </aside>
    </div>

    <section class="faq-s"><Faq k={x.faqk} h={x.faqh} items={faq} /></section>
    <Related lang={lang} id={id} />
  </div>
</Base>
